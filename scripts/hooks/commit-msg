#!/bin/sh
# lumia-harness-closing-v1
# inventory-dependencies: ["scripts/check-github-closing.py", "scripts/github_closing.py", "scripts/install-harness-hooks.py"]
hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 2
if [ -f "$hook_dir/commit-msg.harness-original" ]; then
  "$hook_dir/commit-msg.harness-original" "$@" || exit $?
fi
root=$(git rev-parse --show-toplevel) || exit 2
checker="$root/scripts/check-github-closing.py"
if [ ! -f "$checker" ]; then
  echo 'Closing-reference checker is missing; restore the complete configuration.' >&2
  exit 2
fi
if [ "$OS" = 'Windows_NT' ]; then
  python_cmd=python
else
  python_cmd=python3
fi
exec "$python_cmd" -B -X utf8 "$checker" --message-file "$1"
