#!/bin/sh
# lumia-harness-inventory-v1
# inventory-dependencies: [".prettierrc.json", "backend/build.gradle", "backend/gradle/wrapper/gradle-wrapper.jar", "backend/gradle/wrapper/gradle-wrapper.properties", "backend/gradlew", "backend/gradlew.bat", "backend/settings.gradle", "docs/details/development/java-policy.json", "harness/examples/issue-body-example-42.md", "harness/examples/task-body-example-43-002.md", "harness/examples/task-body-example-db-method.md", "harness/examples/task-body-example-recording.md", "harness/examples/task-execution-example.md", "harness/rule-comments.json", "harness/templates/issue.md", "harness/templates/task-execution.md", "harness/templates/task-plan.md", "harness/templates/task-with-plan.md", "harness/templates/task.md", "package-lock.json", "package.json", "scripts/check-harness-inventory.py", "scripts/check-issue-rule-comments.py", "scripts/check-java.py", "scripts/check-rule-comments.py", "scripts/check-work-records.py", "scripts/harness_inventory.py", "scripts/install-harness-hooks.py", "scripts/install-hooks.py", "scripts/issue_rule_comments.py", "scripts/java_guard.py", "scripts/quality/format.mjs", "scripts/quality/paths.mjs", "scripts/quality/process.mjs", "scripts/rule_comments.py", "scripts/tdd-check.py", "scripts/tdd_core.py"]
hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 2
root=$(git rev-parse --show-toplevel) || exit 2
java_checker="$root/scripts/check-java.py"
java_candidate=$(git ls-files --stage -- 'scripts/check-java.py') || exit 2
java_enabled=false
if [ -n "$java_candidate" ] || git cat-file -e HEAD:scripts/check-java.py 2>/dev/null; then
  java_enabled=true
fi
if [ -f "$hook_dir/pre-commit.harness-original" ]; then
  if "$java_enabled"; then
    LUMIA_JAVA_TDD_SPLIT=1 "$hook_dir/pre-commit.harness-original" "$@" || exit $?
  else
    "$hook_dir/pre-commit.harness-original" "$@" || exit $?
  fi
fi
checker="$root/scripts/check-harness-inventory.py"
if [ ! -f "$checker" ]; then
  candidate_markers=$(git ls-files --stage -- 'scripts/check-harness-inventory.py' 'harness/스킬 현황.md' 'harness/hook 현황.md' 'harness/스킬과 hook 현황.md' 'scripts/check-rule-comments.py' 'scripts/rule_comments.py' 'harness/rule-comments.json' 'scripts/check-issue-rule-comments.py' 'harness/issue-rule-comments.json') || exit 2
  if [ -f "$root/harness/스킬 현황.md" ] || [ -f "$root/harness/hook 현황.md" ] || [ -f "$root/harness/스킬과 hook 현황.md" ] || [ -f "$root/harness/rule-comments.json" ] || [ -f "$root/harness/issue-rule-comments.json" ] || [ -n "$candidate_markers" ]; then
    echo 'Inventory checker is missing; restore the complete configuration.' >&2
    exit 2
  fi
  exit 0
fi
if [ "$OS" = 'Windows_NT' ]; then
  python_cmd=python
else
  python_cmd=python3
fi
"$python_cmd" -B -X utf8 "$checker" --candidate index || exit $?
record_checker="$root/scripts/check-work-records.py"
if [ ! -f "$record_checker" ]; then
  record_candidate=$(git ls-files --stage -- 'scripts/check-work-records.py' 'scripts/check-rule-comments.py' 'scripts/rule_comments.py' 'harness/rule-comments.json' 'scripts/check-issue-rule-comments.py' 'harness/issue-rule-comments.json') || exit 2
  if [ -n "$record_candidate" ] || [ -f "$root/harness/rule-comments.json" ] || [ -f "$root/harness/issue-rule-comments.json" ]; then
    echo 'Record checker is missing; restore the staged checker.' >&2
    exit 2
  fi
  exit 0
fi
"$python_cmd" -B -X utf8 "$record_checker" --candidate index || exit $?
if git cat-file -e ':scripts/quality/format.mjs' 2>/dev/null; then
  if [ ! -f "$root/scripts/quality/format.mjs" ]; then
    echo 'Quality checker is missing; restore the staged configuration.' >&2
    exit 2
  fi
  node "$root/scripts/quality/format.mjs" --index || exit $?
fi
rule_checker="$root/scripts/check-issue-rule-comments.py"
current_markers=$(git ls-files --stage -- 'scripts/check-rule-comments.py' 'scripts/rule_comments.py' 'harness/rule-comments.json') || exit 2
if [ -f "$root/scripts/check-rule-comments.py" ] || [ -f "$root/harness/rule-comments.json" ] || [ -n "$current_markers" ]; then
  rule_checker="$root/scripts/check-rule-comments.py"
  if [ ! -f "$rule_checker" ]; then
    echo 'Current record checker is missing; restore the complete configuration.' >&2
    exit 2
  fi
fi
if [ ! -f "$rule_checker" ]; then
  rule_candidate=$(git ls-files --stage -- 'scripts/check-issue-rule-comments.py' 'harness/issue-rule-comments.json') || exit 2
  if [ -n "$rule_candidate" ] || [ -f "$root/harness/issue-rule-comments.json" ]; then
    echo 'Issue comment checker is missing; restore the complete configuration.' >&2
    exit 2
  fi
  exit 0
fi
"$python_cmd" -B -X utf8 "$rule_checker" --candidate index || exit $?
if ! "$java_enabled"; then
  exit 0
fi
if [ ! -f "$java_checker" ]; then
  echo 'Java checker is missing. Restore the installed checker and retry.' >&2
  exit 2
fi
exec "$python_cmd" -B -X utf8 "$java_checker" --candidate index
