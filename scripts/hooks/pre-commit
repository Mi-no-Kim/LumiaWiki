#!/bin/sh
# lumia-harness-inventory-v1
# inventory-dependencies: ["scripts/check-harness-inventory.py", "scripts/harness_inventory.py", "scripts/install-harness-hooks.py", "scripts/install-hooks.py", "scripts/tdd-check.py", "scripts/tdd_core.py", "scripts/check-work-records.py", "scripts/quality/format.mjs", "scripts/quality/paths.mjs", "scripts/quality/process.mjs", ".prettierrc.json", "package.json", "package-lock.json", "backend/build.gradle", "backend/settings.gradle", "backend/gradlew", "backend/gradlew.bat", "backend/gradle/wrapper/gradle-wrapper.properties", "backend/gradle/wrapper/gradle-wrapper.jar"]
hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 2
if [ -f "$hook_dir/pre-commit.harness-original" ]; then
  "$hook_dir/pre-commit.harness-original" "$@" || exit $?
fi
root=$(git rev-parse --show-toplevel) || exit 2
checker="$root/scripts/check-harness-inventory.py"
if [ ! -f "$checker" ]; then
  candidate_markers=$(git ls-files --stage -- 'scripts/check-harness-inventory.py' 'harness/스킬 현황.md' 'harness/hook 현황.md' 'harness/스킬과 hook 현황.md') || exit 2
  if [ -f "$root/harness/스킬 현황.md" ] || [ -f "$root/harness/hook 현황.md" ] || [ -f "$root/harness/스킬과 hook 현황.md" ] || [ -n "$candidate_markers" ]; then
    echo 'Inventory checker is missing; restore the complete configuration.' >&2
    exit 2
  fi
  exit 0
fi
if [ "$OS" = 'Windows_NT' ]; then
  python_cmd=python
else
  python_cmd=python3
fi
"$python_cmd" -B -X utf8 "$checker" --candidate index || exit $?
record_checker="$root/scripts/check-work-records.py"
if [ ! -f "$record_checker" ]; then
  record_candidate=$(git ls-files --stage -- 'scripts/check-work-records.py') || exit 2
  if [ -n "$record_candidate" ]; then
    echo 'Record checker is missing; restore the staged checker.' >&2
    exit 2
  fi
  exit 0
fi
"$python_cmd" -B -X utf8 "$record_checker" --candidate index || exit $?
if git cat-file -e ':scripts/quality/format.mjs' 2>/dev/null; then
  if [ ! -f "$root/scripts/quality/format.mjs" ]; then
    echo 'Quality checker is missing; restore the staged configuration.' >&2
    exit 2
  fi
  exec node "$root/scripts/quality/format.mjs" --index
fi
