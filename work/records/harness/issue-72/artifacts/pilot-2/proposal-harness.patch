+"""Explicit drafts and authored-size warnings; all fixtures use caller TMPDIR."""
+import importlib.util
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+import tempfile
+import unittest
+from unittest import mock
+
+SCRIPTS = Path(__file__).resolve().parents[1]
+ROOT = SCRIPTS.parent
+POLICY = json.loads((ROOT / 'harness/rule-comments.json').read_text(encoding='utf-8'))
+sys.path.insert(0, str(SCRIPTS))
+
+
+def record_checker():
+    spec = importlib.util.spec_from_file_location('pilot_record_checker', SCRIPTS / 'check-work-records.py')
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def task_body():
+    text = (ROOT / 'harness/templates/task.md').read_text(encoding='utf-8')
+    return re.search(r'^```markdown\n(.*?)^```', text, re.M | re.S)[1]
+
+
+class ExplicitDraftTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(prefix='explicit-draft-')
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.path = self.root / 'task.md'
+        self.path.write_text(task_body(), encoding='utf-8')
+
+    def run_cli(self, *args):
+        return subprocess.run([sys.executable, '-B', '-X', 'utf8', str(SCRIPTS / 'check-rule-comments.py'), *args],
+                              cwd=self.root, capture_output=True, text=True, encoding='utf-8', timeout=15)
+
+    def test_explicit_draft_is_read_only_and_not_a_formal_record(self):
+        before = self.path.read_bytes()
+        result = self.run_cli('--draft', 'task.md', '--profile', 'task')
+        self.assertEqual(0, result.returncode, result.stderr)
+        data = json.loads(result.stdout)
+        self.assertFalse(data['formalRecord'])
+        self.assertEqual([], data['errors'])
+        self.assertEqual(before, self.path.read_bytes())
+        self.assertFalse((self.root / '.git').exists())
+
+    def test_missing_protected_comment_is_rejected(self):
+        self.path.write_text(task_body().replace(POLICY['profiles']['task']['comments']['start'], ''), encoding='utf-8')
+        result = self.run_cli('--draft', 'task.md', '--profile', 'task')
+        self.assertEqual(2, result.returncode)
+        self.assertIn('task-rule:start', result.stdout)
+
+    def test_invalid_state_is_rejected(self):
+        self.path.write_text(task_body().replace('- 상태: 예정', '- 상태: 검증 중'), encoding='utf-8')
+        result = self.run_cli('--draft', 'task.md', '--profile', 'task')
+        self.assertEqual(2, result.returncode)
+        self.assertIn('current state', result.stdout)
+
+    def test_profile_is_required(self):
+        self.assertEqual(2, self.run_cli('--draft', 'task.md').returncode)
+
+    def test_draft_cannot_mix_with_hook_or_candidate(self):
+        for extra in [('--hook',), ('--candidate', 'work')]:
+            with self.subTest(extra=extra):
+                result = self.run_cli('--draft', 'task.md', '--profile', 'task', *extra)
+                self.assertEqual(2, result.returncode)
+                self.assertIn('cannot combine', result.stderr)
+
+    def test_directory_is_rejected(self):
+        self.assertEqual(2, self.run_cli('--draft', '.', '--profile', 'task').returncode)
+
+    def test_cwd_escape_is_rejected(self):
+        result = self.run_cli('--draft', str(ROOT / 'harness/templates/task.md'), '--profile', 'task')
+        self.assertEqual(2, result.returncode)
+        self.assertIn('within the current', result.stderr)
+
+    def test_preserved_or_private_path_is_rejected_before_read(self):
+        for name in ['harness-design/never.md', '.harness-state/never.md', '.aws/never.md']:
+            with self.subTest(name=name):
+                result = self.run_cli('--draft', name, '--profile', 'task')
+                self.assertEqual(2, result.returncode)
+                self.assertIn('Preserved/private', result.stderr)
+
+    def test_forbidden_cwd_is_rejected_before_read(self):
+        spec = importlib.util.spec_from_file_location('draft_cli', SCRIPTS / 'check-issue-rule-comments.py')
+        module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(module)
+        # Mock only the cwd value; do not create or read a preservation directory.
+        for folder in ['harness-design', '.harness-state', '.git', '.aws']:
+            with self.subTest(folder=folder), mock.patch.object(module.Path, 'cwd', return_value=self.root / folder):
+                with self.assertRaisesRegex(ValueError, 'Preserved/private'):
+                    module.check_draft('task.md', 'task')
+
+
+class AuthoredLengthTests(unittest.TestCase):
+    def setUp(self):
+        self.module = record_checker()
+        self.fixed = list(POLICY['profiles']['task']['comments'].values())
+        self.comment = POLICY['profiles']['task']['comments']['tags']
+
+    def test_fixed_live_standalone_comments_do_not_consume_warning_budget(self):
+        errors, warnings = self.module.inspect_record('work/records/harness/issue-1/task-001.md', task_body(), None, self.fixed)
+        self.assertEqual(([], []), (errors, warnings))
+        self.assertLess(self.module.authored_line_count(task_body(), self.fixed), 100)
+        self.assertGreater(len(task_body().splitlines()), 100)
+
+    def test_written_content_above_threshold_still_warns(self):
+        text = '\n'.join(self.fixed) + '\n' + 'authored decision\n' * 101
+        errors, warnings = self.module.inspect_record('work/records/harness/issue-1/task-001.md', text, None, self.fixed)
+        self.assertFalse(errors)
+        self.assertEqual(1, len(warnings))
+        self.assertIn('101 authored lines', warnings[0])
+
+    def test_fenced_or_changed_comments_remain_counted(self):
+        for text in ['```markdown\n' + self.comment + '\n```', self.comment.replace('Task 태그', 'Changed 태그', 1)]:
+            with self.subTest(text=text[:30]):
+                self.assertEqual(len(text.splitlines()), self.module.authored_line_count(text, self.fixed))
+
+    def test_inline_prose_is_not_hidden_by_a_protected_comment(self):
+        text = 'authored decision ' + self.comment + '\n'
+        self.assertEqual(len(text.splitlines()), self.module.authored_line_count(text, self.fixed))
+
+    def test_crlf_and_lf_counts_match(self):
+        self.assertEqual(self.module.authored_line_count(task_body(), self.fixed),
+                         self.module.authored_line_count(task_body().replace('\n', '\r\n'), self.fixed))
+
+    def test_issue_cli_does_not_exclude_task_only_comments(self):
+        with tempfile.TemporaryDirectory(prefix='profile-length-') as folder:
+            root = Path(folder)
+            subprocess.run(['git', 'init', '-q'], cwd=root, check=True, capture_output=True)
+            (root / 'harness').mkdir()
+            (root / 'harness/rule-comments.json').write_text(json.dumps(POLICY), encoding='utf-8')
+            name = 'work/records/harness/issue-1/issue.md'
+            target = root / name
+            target.parent.mkdir(parents=True)
+            issue_comments = list(POLICY['profiles']['issue']['comments'].values())
+            text = '\n'.join(issue_comments) + '\n' + self.comment + '\n'
+            text += 'authored decision\n' * (110 - self.module.authored_line_count(text, issue_comments))
+            target.write_text(text, encoding='utf-8')
+            subprocess.run(['git', 'add', '--', 'harness', 'work'], cwd=root, check=True, capture_output=True)
+            result = subprocess.run([sys.executable, '-B', '-X', 'utf8', str(SCRIPTS / 'check-work-records.py'), '--candidate', 'index'], cwd=root, capture_output=True, text=True, encoding='utf-8')
+            self.assertEqual(0, result.returncode, result.stderr)
+            self.assertIn('110 authored lines', result.stderr)
+
+
+if __name__ == '__main__':
+    unittest.main()
